# Supabase Configuration
# This file is for reference only. The app comes with pre-configured credentials.
# To use your own Supabase project, copy this file to .env and update the values below:

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: The app includes default credentials for immediate use.
# Only override them if you want to use your own Supabase project.
